# ============================================================================
# RAG Evaluation & Optimization Tool - Environment Configuration
# Copy this file to ".env" and fill in your keys. NEVER commit the real .env!
# ============================================================================

# REQUIRED: Free API key from https://console.groq.com
GROQ_API_KEY=

# Optional: Default Models (also selectable directly in the Web UI)
# Supported Generator options: llama-3.3-70b-versatile, llama-3.1-8b-instant,
#                             openai/gpt-oss-120b, openai/gpt-oss-20b, qwen-2.5-32b
GENERATOR_MODEL=llama-3.3-70b-versatile

# Supported Judge options: openai/gpt-oss-120b, llama-3.3-70b-versatile,
#                          deepseek-r1-distill-llama-70b, llama-3.1-8b-instant
JUDGE_MODEL=openai/gpt-oss-120b

# Optional Tuning Parameters
TOP_K=4
MAX_PARALLEL=3
MAX_UPLOAD_MB=20

# Optional: Hugging Face token (for faster / higher-limit model downloads)
# HF_TOKEN=
